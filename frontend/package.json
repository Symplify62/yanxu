{
  "name": "yanxu-frontend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" vite.config.ts playwright.config.ts tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "1.47.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "element-plus": "2.14.6",
    "msw": "2.15.0",
    "qrcode": "1.5.4",
    "reka-ui": "2.10.4",
    "tailwind-merge": "3.7.0",
    "tdesign-vue-next": "1.20.8",
    "tw-animate-css": "1.4.0",
    "vant": "4.10.2",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
