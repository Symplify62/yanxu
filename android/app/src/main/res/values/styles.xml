<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#466B4F</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8F4</item>
        <item name="android:navigationBarColor">#F7F8F4</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/YanxuAlertTheme</item>
    </style>
    <style name="YanxuAlertTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#466B4F</item>
        <item name="android:textColorPrimary">#243B30</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
    </style>
</resources>
