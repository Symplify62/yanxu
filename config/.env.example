# Server-side DeepSeek configuration. Never use VITE_ for this key.
# Copy to config/.env.local and fill only your key; the local file is git-ignored.
# Read by backend/yanxu/config.py; restart API and worker after changing settings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=180

# Optional local resource limits
# YANXU_MAX_UPLOAD_BYTES=2147483648
# YANXU_DAILY_TOKEN_BUDGET=200000
# YANXU_DATA_DIR=/absolute/path/to/persistent/data

# Cloud mirror is opt-in. Keep keys on the backend only.
YANXU_STORAGE=local
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=yanxu-recordings
QINIU_PUBLIC_BASE_URL=https://audio.qjl666.xyz
# Enable redirects only after HTTPS/Range/download verification.
QINIU_DELIVERY_ENABLED=false

# Cloud host: run DeepSeek only; Mac polls authenticated ASR tasks over HTTPS.
YANXU_WORKER_STAGE=all
YANXU_WORKER_TOKEN=
YANXU_REMOTE_API=
# Cloud host disk headroom; 0 keeps historical local behavior.
YANXU_MIN_FREE_BYTES=0

# Account / private voice services. Bootstrap administrator via password stdin.
YANXU_IDENTITY_ENABLED=true
YANXU_SESSION_HOURS=24
# Separate credentials: an ASR worker cannot download accounts/voice profiles.
YANXU_BACKUP_TOKEN=
YANXU_VOICE_WORKER_TOKEN=
# Install tools/voice-runtime separately; API never downloads/runs models.
YANXU_VOICE_ENGINE_COMMAND=
YANXU_VOICE_MODEL_VERSION=wespeaker-cnceleb-resnet34-lm:e7584940aeac8d55:kaldi80-v1
YANXU_VOICE_MATCH_THRESHOLD=0.75
YANXU_VOICE_MATCH_MARGIN=0.08
# Enrollment audio stays in YANXU_DATA_DIR/private-voices. Do not reuse the public bucket.
# Optional mirror requires a separate bucket verified private on every upload.
# YANXU_VOICE_PRIVATE_BUCKET=
