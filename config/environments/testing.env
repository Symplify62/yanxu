# Non-secret test environment. Secrets belong in /etc/yanxu-test.env or a local ignored file.
YANXU_ENVIRONMENT=testing
YANXU_PUBLIC_ORIGIN=https://test-yanxu.qjl666.xyz
YANXU_AUDIO_ORIGIN=https://audio-test.qjl666.xyz
YANXU_UPDATE_ORIGIN=https://test-yanxu.qjl666.xyz
YANXU_DATA_DIR=/var/lib/yanxu-test/data
YANXU_STORAGE=qiniu
QINIU_BUCKET=yanxu-test-recordings
QINIU_PUBLIC_BASE_URL=https://audio-test.qjl666.xyz
QINIU_DELIVERY_ENABLED=true
YANXU_WORKER_STAGE=analysis
YANXU_DAILY_TOKEN_BUDGET=20000
YANXU_MIN_FREE_BYTES=536870912
YANXU_REMOTE_API=https://test-yanxu.qjl666.xyz
YANXU_IDENTITY_ENABLED=true
ANDROID_APPLICATION_ID=cn.jiajian.yanxu.testing
ANDROID_APP_LABEL=言序测试
ANDROID_UPDATE_ENABLED=true
