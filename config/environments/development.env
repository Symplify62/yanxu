# Non-secret local defaults. Explicitly select with YANXU_ENVIRONMENT=development.
YANXU_ENVIRONMENT=development
YANXU_PUBLIC_ORIGIN=http://127.0.0.1:5189
YANXU_AUDIO_ORIGIN=
YANXU_UPDATE_ORIGIN=
YANXU_STORAGE=local
YANXU_WORKER_STAGE=all
YANXU_IDENTITY_ENABLED=true
ANDROID_APPLICATION_ID=cn.jiajian.yanxu.development
ANDROID_APP_LABEL=言序开发
ANDROID_UPDATE_ENABLED=false
